# Copy this file to .env and fill only the services you use.
# Never commit a populated .env file.

# News collection and LLM annotation
X_BEARER_TOKEN=
GUARDIAN_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional market-data credentials. Yahoo requires no key.

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# TWELVEDATA_API_KEY is also accepted as an alias.
TWELVE_DATA_API_KEY=

FMP_API_KEY=
